    {
      "parameters": {
        "endpointUrl": "http://mcp-server:8000/mcp",
        "tool": {
          "__rl": true,
          "mode": "list",
          "value": "query_database",
          "cachedResultName": "query_database"
        },
        "inputMode": "json",
        "jsonInput": "={{ JSON.stringify({ query: \"SELECT s.id AS schueler_id, s.vorname, s.nachname, s.klasse, k.id AS kurs_id, k.fach FROM schueler s JOIN kurse k ON k.klasse = s.klasse WHERE s.klasse = '\" + $json.Klasse + \"' AND k.fach = '\" + $json.Fach + \"' AND s.nachname = '\" + $json.Nachname.trim().replace(/'/g, \"''\") + \"'\" }) }}",
        "options": {}
      },
      "id": "e6dfbb08-ef4e-4212-a14b-43b4a1cc23f8",
      "name": "MCP: Schüler suchen",
      "type": "@n8n/n8n-nodes-langchain.mcpClient",
      "typeVersion": 1.1,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Ergebnis des MCP-Servers (Text mit JSON) in Felder umwandeln\nconst form = $('Formular: Note eintragen').first().json;\nconst text = $input.first().json.content?.[0]?.text ?? $input.first().json.result ?? '[]';\nlet treffer = [];\ntry { treffer = JSON.parse(text); } catch (e) { treffer = []; }\nconst t = treffer[0] || {};\nreturn [{ json: {\n  anzahl: treffer.length,\n  schueler_id: t.schueler_id, kurs_id: t.kurs_id,\n  name: `${t.vorname ?? ''} ${t.nachname ?? ''}`.trim(),\n  klasse: form.Klasse, fach: form.Fach,\n  note: Number(form.Note), art: form.Art,\n  kandidaten: treffer.map(x => `${x.vorname} ${x.nachname}`).join(', ')\n} }];"
      },
