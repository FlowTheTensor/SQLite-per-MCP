    {
      "parameters": {
        "endpointUrl": "http://mcp-server:8000/mcp",
        "tool": {
          "__rl": true,
          "mode": "list",
          "value": "query_database",
          "cachedResultName": "query_database"
        },
        "inputMode": "json",
        "jsonInput": "={{ JSON.stringify({ query: \"SELECT ROUND(AVG(n.note),2) AS durchschnitt, COUNT(*) AS anzahl, MIN(n.note) AS beste, MAX(n.note) AS schlechteste FROM noten n JOIN kurse k ON k.id = n.kurs_id WHERE k.klasse = '\" + $json.Klasse + \"' AND k.fach = '\" + $json.Fach + \"'\" }) }}",
        "options": {}
      },
      "id": "1eafe424-d3e4-42d8-b6d4-aef04a2e3c71",
      "name": "MCP: query_database",
      "type": "@n8n/n8n-nodes-langchain.mcpClient",
      "typeVersion": 1.1,
      "position": [
        260,
        0
      ]
    },
    {
      "parameters": {
        "operation": "completion",
        "respondWith": "showText",
        "responseText": "={{ (() => {\n  const form = $('Formular: Klasse und Fach').item.json;\n  // n8n hat den JSON-Text des MCP-Servers schon in eine Liste umgewandelt.\n  // Ist die Antwort ein normaler Text, ist es eine Meldung wie \"Fehler: ...\".\n  const antwort = $json.content[0].text;\n  if (typeof antwort === 'string') return `<p>${antwort}</p>`;\n  const r = antwort[0];\n  return `<h2>${form.Fach} in der ${form.Klasse}</h2><p>Durchschnitt: <b>${r.durchschnitt}</b><br>Anzahl Noten: ${r.anzahl}<br>Beste Note: ${r.beste} – schlechteste Note: ${r.schlechteste}</p>`;\n})() }}"
      },
